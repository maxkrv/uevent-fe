{
  "name": "vite-react-typescript-eslint-prettier",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview --port 3000",
    "start": "npm run build && npm run preview",
    "lint": "eslint --quiet --cache --report-unused-disable-directives src/**/*.{ts,tsx,js,jsx}",
    "lint:fix": "eslint --fix --quiet --cache --report-unused-disable-directives src/**/*.{ts,tsx,js,jsx}",
    "format": "prettier --write --ignore-unknown .",
    "prepare": "husky",
    "test": "vitest"
  },
  "dependencies": {
